{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Expo (Metro bundler)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start"],
      "port": 8081,
      "cwd": "AplikacjaLekarza"
    },
    {
      "name": "Expo Web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web"],
      "port": 8081,
      "cwd": "AplikacjaLekarza"
    },
    {
      "name": "PostgREST API + PostgreSQL (Docker)",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "up", "-d"],
      "port": 3001,
      "cwd": "supabase"
    }
  ]
}
